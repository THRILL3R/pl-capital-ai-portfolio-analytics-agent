# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Secrets and environment configurations
# .env.example IS tracked: it must only ever contain placeholder values.
.env
*.env
.env.*
!.env.example

# SQLite Databases & runtime files
database/*.db
database/*.db-journal
database/*.db-wal
database/*.db-shm
database/*.tmp
*.sqlite
*.sqlite3

# Streamlit
.streamlit/

# Testing & coverage
.coverage
htmlcov/
.tox/

# Logs
*.log

# Editor / IDE / local tooling
.vscode/
.idea/
.claude/

# OS specific files
.DS_Store
Thumbs.db
desktop.ini
