# Files that must never be uploaded to Vercel. The Vercel CLI does NOT read .gitignore when deploying from a
# local folder, so everything sensitive or generated is listed here explicitly.

# Secrets and local configuration
.env
.env.*

# Local environments, caches and generated data (the database is rebuilt from data/ at runtime)
.git
.venv
.model_cache
.vercel
database
**/__pycache__
*.pyc

# Frontend: dependencies and build output are produced by Vercel's own build
frontend/node_modules
frontend/dist
frontend/coverage

# Reports: the Evaluation page and /api/evaluation serve only the final live and deterministic reports, so only
# those two are uploaded (older run reports stay in the repository's docs/ but are not deployed)
evaluation_report.md
docs/*
!docs/EVALUATION_FINAL_LIVE_20261109.md
!docs/EVALUATION_DETERMINISTIC.md

# Not part of the deployed application
submission
tests
scripts
